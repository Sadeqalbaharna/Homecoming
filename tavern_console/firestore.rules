rules_version = '2';

// Tenant isolation for the costing platform.
//
// Two collections:
//   users/{uid}   -> { org, role, email }   the caller's membership
//   orgs/{org}    -> { owner, name, venues[], members{uid:role}, ... }
//
// The rule of the whole system: a signed-in user may only ever touch the org
// they belong to. Everything hangs off users/{uid}.org.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user document is readable/writable only by that user. On first sign-in
    // the client creates users/{uid} with org == uid (a fresh org they own),
    // which is the only shape we allow them to self-create.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.org == uid
                    && request.resource.data.role == 'owner';
      // Role/org changes are done by trusted server code, not the client.
      allow update, delete: if false;
    }

    function myOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.org;
    }
    function isMember(org) {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && myOrg() == org;
    }
    function isOwner(org) {
      return isMember(org)
             && get(/databases/$(database)/documents/orgs/$(org)).data.owner == request.auth.uid;
    }

    match /orgs/{org} {
      // Any member may read the org (needs the venue list). The owner may
      // create it (only with themselves as owner) and edit it.
      allow read:   if isMember(org);
      allow create: if request.auth != null
                    && request.auth.uid == org
                    && request.resource.data.owner == request.auth.uid;
      allow update: if isOwner(org);
      allow delete: if false;

      // The venue books: one document per venue, holding the whole book as a
      // JSON blob. Any member of the org may read and write its own venues.
      match /venues/{venue} {
        allow read, write: if isMember(org);
      }
    }
  }
}
