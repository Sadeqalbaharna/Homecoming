<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.homecoming.app">

    <!-- Needed for Flask calls + ElevenLabs playback -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed for microphone recording (long-press to talk) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- System overlay permission - allows app to draw over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Foreground service permission for overlay service (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Kai agentic tools -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Required for AlarmClock.ACTION_SET_ALARM with EXTRA_SKIP_UI=true -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Required for AlarmClock.ACTION_SET_TIMER with EXTRA_SKIP_UI=true -->
    <uses-permission android:name="com.android.alarm.permission.SET_TIMER" />
    <!-- Lets openApp() fuzzy-match installed app labels -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- WorkManager: reschedule jobs after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WorkManager: keep CPU alive during background job -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- NFC — read coin UIDs for Tavern guest registration -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Smart home: SSDP multicast discovery for TVs and devices on local WiFi -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="${applicationName}"
        android:label="Kai"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- Flutter v2 embedding (v1 was removed in Flutter 3.x) -->
        <meta-data android:name="flutterEmbedding" android:value="2" />

        <!-- The status-bar icon for Kai's push notifications.
             Android renders the small icon as a WHITE SILHOUETTE regardless of
             its colours, so this MUST be a monochrome shape — his face would
             just become a white blob. ic_stat_kai is the P5 bolt. The accent
             colour tints the app-name and icon in the shade. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_kai" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kai_red" />
        <!-- usesCleartextTraffic=false is fine since you're using HTTPS.
             Set true only if you ever point to http:// during dev. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:enableOnBackInvokedCallback="true">
            <!-- Transparency and overlay flags -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- Flutter Overlay Window Service - REQUIRED by flutter_overlay_window package -->
        <service
            android:name="flutter.overlay.window.flutter_overlay_window.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="System overlay window for AI assistant" />
        </service>

        <!-- Audio Recording Service — foreground service for microphone access -->
        <service
            android:name=".AudioRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Kai Notification Listener — captures incoming notifications for read_notifications tool -->
        <service
            android:name=".KaiNotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Kai Accessibility Service — reads visible screen content for read_screen tool -->
        <service
            android:name=".KaiAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name"
            android:description="@string/accessibility_service_description">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kai_accessibility_config" />
        </service>

    </application>

</manifest>
