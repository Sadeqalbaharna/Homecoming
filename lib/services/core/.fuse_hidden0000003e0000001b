// EmotionalEventService — Phase 2 of Kai's unified mind.
//
// Records how conversations made Kai feel and carries those feelings forward
// across sessions and surfaces. No extra API calls — classification is pure
// heuristics based on the mood deltas already computed in AIService.
//
// Firebase path: /kai/{personaId}/emotional_events/{eventId}
//
// Lifecycle:
//   1. sendMessage() → classifyAndLog() after state is saved
//   2. bootstrapPersona() → applyEventsToMood() before first message
//   3. Events decay over time (older = less weight). Nothing older than 7 days
//      contributes to mood at all.

library;

import 'dart:async';
import 'package:firebase_database/firebase_database.dart';
import 'firebase_service.dart';

// ─── Model ──────────────────────────────────────────────────────────────────

enum EmotionalEventType {
  warmth,       // connection, affection, care expressed
  conflict,     // tension, disagreement, frustration
  intellectual, // curiosity, learning, deep discussion
  playful,      // humor, lightness, fun exchange
  deep,         // multiple strong shifts — highly significant exchange
  neutral,      // low-intensity, routine exchange
}

class EmotionalEvent {
  final String id;
  final EmotionalEventType type;
  final int intensity;       // –100 to +100. Positive = uplifting, negative = draining
  final String topic;        // first 60 chars of user message
  final DateTime timestamp;
  final bool resolved;
  final String source;       // surface that logged this event

  const EmotionalEvent({
    required this.id,
    required this.type,
    required this.intensity,
    required this.topic,
    required this.timestamp,
    this.resolved = false,
    required this.source,
  });

  Map<String, dynamic> toFirebase() => {
    'type': type.name,
    'intensity': intensity,
    'topic': topic,
    'timestamp': timestamp.millisecondsSinceEpoch,
    'resolved': resolved,
    'source': source,
  };

  static EmotionalEvent fromFirebase(String id, Map raw) => EmotionalEvent(
    id: id,
    type: EmotionalEventType.values.firstWhere(
      (e) => e.name == raw['type'],
      orElse: () => EmotionalEventType.neutral,
    ),
    intensity: (raw['intensity'] as num?)?.toInt() ?? 0,
    topic: (raw['topic'] as String?) ?? '',
    timestamp: DateTime.fromMillisecondsSinceEpoch(
      (raw['timestamp'] as num?)?.toInt() ?? 0,
    ),
    resolved: (raw['resolved'] as bool?) ?? false,
    source: (raw['source'] as String?) ?? 'unknown',
  );
}

// ─── Service ────────────────────────────────────────────────────────────────

class EmotionalEventService {
  static final EmotionalEventService _instance = EmotionalEventService._internal();
  factory EmotionalEventService() => _instance;
  EmotionalEventService._internal();

  String _surface = 'unknown';
  void setSurface(String s) => _surface = s;

  static String _eventsPath(String personaId) =>
      'kai/$personaId/emotional_events';

  static FirebaseDatabase? get _db =>
      FirebaseService.isAvailable ? KaiDb.instance : null;

  // ── Classify & log ─────────────────────────────────────────────────────────

  /// Call after sendMessage() completes. Classifies the exchange based on
  /// mood deltas and logs an emotional event to Firebase.
  Future<void> classifyAndLog({
    required String personaId,
    required String userMessage,
    required String aiReply,
    required Map<String, int> moodDeltas,
  }) async {
    if (_db == null) return;

    final event = _classify(
      userMessage: userMessage,
      aiReply: aiReply,
      moodDeltas: moodDeltas,
    );

    // Skip trivial neutral exchanges — don't flood the log
    if (event.type == EmotionalEventType.neutral && event.intensity.abs() < 5) {
      return;
    }

    try {
      final ref = _db!.ref(_eventsPath(personaId)).push();
      await ref.set(event.toFirebase());
      print('💛 [EmotionalEvent] Logged ${event.type.name} (${event.intensity > 0 ? '+' : ''}${event.intensity}) for $personaId');
    } catch (e) {
      print('⚠️ [EmotionalEvent] Failed to log event: $e');
    }
  }

  // ── Load & apply ───────────────────────────────────────────────────────────

  /// Load unresolved events and return a mood offset map to apply at session start.
  /// Older events have less weight — linear decay over 7 days.
  Future<Map<String, int>> getMoodOffset(String personaId) async {
    if (_db == null) return {};

    try {
      final snap = await _db!.ref(_eventsPath(personaId)).get();
      if (!snap.exists || snap.value == null) return {};

      final raw = Map<String, dynamic>.from(snap.value as Map);
      final now = DateTime.now();
      final offsets = <String, double>{};
      final toResolve = <String>[];

      for (final entry in raw.entries) {
        final event = EmotionalEvent.fromFirebase(entry.key, entry.value as Map);

        if (event.resolved) continue;

        final ageDays = now.difference(event.timestamp).inHours / 24.0;

        // Auto-resolve events older than 7 days
        if (ageDays >= 7) {
          toResolve.add(entry.key);
          continue;
        }

        // Decay factor: 1.0 at age 0, 0.0 at age 7 days
        final decay = 1.0 - (ageDays / 7.0);
        final weightedIntensity = event.intensity * decay;

        // Map event type → affected mood traits
        final traits = _traitsForType(event.type);
        for (final trait in traits) {
          offsets[trait] = (offsets[trait] ?? 0) + weightedIntensity;
        }
      }

      // Auto-resolve stale events (fire-and-forget)
      for (final id in toResolve) {
        _db!.ref('${_eventsPath(personaId)}/$id/resolved').set(true);
      }

      if (offsets.isEmpty) return {};

      // Convert to int offsets, capped at ±15 per trait
      final result = <String, int>{};
      for (final entry in offsets.entries) {
        result[entry.key] = entry.value.round().clamp(-15, 15);
      }

      print('💛 [EmotionalEvent] Mood offsets from history: $result');
      return result;
    } catch (e) {
      print('⚠️ [EmotionalEvent] Failed to load events: $e');
      return {};
    }
  }

  /// Apply historical emotional offsets to a mood map.
  /// Returns a new map — does not mutate the input.
  Map<String, int> applyOffsets(
    Map<String, int> currentMood,
    Map<String, int> offsets,
  ) {
    if (offsets.isEmpty) return currentMood;
    final result = Map<String, int>.from(currentMood);
    for (final entry in offsets.entries) {
      if (result.containsKey(entry.key)) {
        result[entry.key] = (result[entry.key]! + entry.value).clamp(0, 100);
      }
    }
    return result;
  }

  // ── Private helpers ────────────────────────────────────────────────────────

  EmotionalEvent _classify({
    required String userMessage,
    required String aiReply,
    required Map<String, int> moodDeltas,
  }) {
    final (type, intensity) = classifySync(moodDeltas);
    final topic = userMessage.length > 60
        ? userMessage.substring(0, 60)
        : userMessage;
    return EmotionalEvent(
      id: '',
      type: type,
      intensity: intensity,
      topic: topic,
      timestamp: DateTime.now(),
      source: _surface,
    );
  }

  /// Synchronous classification from mood deltas — no Firebase, no async.
  /// Call this to decide extraction depth BEFORE awaiting classifyAndLog.
  static (EmotionalEventType type, int intensity) classifySync(
    Map<String, int> moodDeltas,
  ) {
    final warmthDelta  = moodDeltas['warmth']      ?? 0;
    final valenceDelta = moodDeltas['valence']     ?? 0;
    final energyDelta  = moodDeltas['energy']      ?? 0;
    final focusDelta   = moodDeltas['focus']       ?? 0;
    final playDelta    = moodDeltas['playfulness'] ?? 0;

    final totalMagnitude = moodDeltas.values.fold(0, (sum, v) => sum + v.abs());

    EmotionalEventType type;
    int intensity;

    if (totalMagnitude >= 30 && valenceDelta >= 0) {
      type      = EmotionalEventType.deep;
      intensity = (valenceDelta + warmthDelta + (energyDelta ~/ 2)).clamp(-100, 100);
    } else if (warmthDelta >= 8) {
      type      = EmotionalEventType.warmth;
      intensity = warmthDelta.clamp(0, 100);
    } else if (valenceDelta <= -8) {
      type      = EmotionalEventType.conflict;
      intensity = valenceDelta.clamp(-100, 0);
    } else if (playDelta >= 6) {
      type      = EmotionalEventType.playful;
      intensity = playDelta.clamp(0, 100);
    } else if (focusDelta >= 6 || energyDelta >= 6) {
      type      = EmotionalEventType.intellectual;
      intensity = ((focusDelta + energyDelta) ~/ 2).clamp(0, 100);
    } else {
      type      = EmotionalEventType.neutral;
      intensity = valenceDelta.clamp(-20, 20);
    }

    return (type, intensity);
  }

  /// Which mood traits an event type primarily affects on replay.
  List<String> _traitsForType(EmotionalEventType type) {
    switch (type) {
      case EmotionalEventType.warmth:
        return ['warmth', 'valence'];
      case EmotionalEventType.conflict:
        return ['valence', 'energy'];
      case EmotionalEventType.intellectual:
        return ['focus', 'energy'];
      case EmotionalEventType.playful:
        return ['playfulness', 'energy'];
      case EmotionalEventType.deep:
        return ['warmth', 'valence', 'focus'];
      case EmotionalEventType.neutral:
        return ['valence'];
    }
  }
}
