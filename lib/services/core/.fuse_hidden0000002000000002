// ActivityCardService
//
// After each conversation turn, saves a rich "activity card" to Firebase
// capturing every signal that came out of that turn:
//   - User message / Kai reply
//   - Personality & mood deltas
//   - Tags, MBTI snapshot
//   - Memories recalled (from embeddings)
//   - Whether web search was used
//
// Firebase path: kai/{personaId}/activity_cards/{push-key}
// Cards are read back in reverse-chronological order for the feed.

library;

import 'package:firebase_database/firebase_database.dart';
import 'firebase_service.dart';

class ActivityCard {
  final String id;
  final int timestamp;
  final String userMessage;
  final String kaiReply;
  final Map<String, int> personalityDelta;
  final Map<String, int> moodDelta;
  final List<String> tags;
  final String mbti;
  final List<String> memoriesUsed;
  final bool webSearchUsed;
  final String? curiosityQuestion;
  final int inputTokens;
  final int outputTokens;
  final double costUsd;

  const ActivityCard({
    required this.id,
    required this.timestamp,
    required this.userMessage,
    required this.kaiReply,
    required this.personalityDelta,
    required this.moodDelta,
    required this.tags,
    required this.mbti,
    required this.memoriesUsed,
    required this.webSearchUsed,
    this.curiosityQuestion,
    this.inputTokens  = 0,
    this.outputTokens = 0,
    this.costUsd      = 0.0,
  });

  Map<String, dynamic> toJson() => {
    'timestamp':        timestamp,
    'userMessage':      userMessage.length > 200 ? '${userMessage.substring(0, 200)}…' : userMessage,
    'kaiReply':         kaiReply.length > 400 ? '${kaiReply.substring(0, 400)}…' : kaiReply,
    'personalityDelta': personalityDelta,
    'moodDelta':        moodDelta,
    'tags':             tags,
    'mbti':             mbti,
    'memoriesUsed':     memoriesUsed,
    'webSearchUsed':    webSearchUsed,
    'inputTokens':      inputTokens,
    'outputTokens':     outputTokens,
    'costUsd':          costUsd,
    if (curiosityQuestion != null) 'curiosityQuestion': curiosityQuestion,
  };

  factory ActivityCard.fromJson(String id, Map<dynamic, dynamic> json) {
    Map<String, int> _intMap(dynamic v) {
      if (v == null) return {};
      final m = Map<String, dynamic>.from(v as Map);
      return m.map((k, val) => MapEntry(k, (val as num).toInt()));
    }
    List<String> _strList(dynamic v) {
      if (v == null) return [];
      if (v is List) return v.map((e) => e.toString()).toList();
      if (v is Map) return v.values.map((e) => e.toString()).toList();
      return [];
    }

    return ActivityCard(
      id:                id,
      timestamp:         (json['timestamp'] as num?)?.toInt() ?? 0,
      userMessage:       json['userMessage']?.toString() ?? '',
      kaiReply:          json['kaiReply']?.toString() ?? '',
      personalityDelta:  _intMap(json['personalityDelta']),
      moodDelta:         _intMap(json['moodDelta']),
      tags:              _strList(json['tags']),
      mbti:              json['mbti']?.toString() ?? '',
      memoriesUsed:      _strList(json['memoriesUsed']),
      webSearchUsed:     json['webSearchUsed'] == true,
      curiosityQuestion: json['curiosityQuestion']?.toString(),
      inputTokens:       (json['inputTokens']  as num?)?.toInt() ?? 0,
      outputTokens:      (json['outputTokens'] as num?)?.toInt() ?? 0,
      costUsd:           (json['costUsd'] as num?)?.toDouble() ?? 0.0,
    );
  }
}

class ActivityCardService {
  static final ActivityCardService _instance = ActivityCardService._internal();
  factory ActivityCardService() => _instance;
  ActivityCardService._internal();

  static FirebaseDatabase? get _db =>
      FirebaseService.isAvailable ? KaiDb.instance : null;

  /// Save a card fire-and-forget style.
  Future<void> saveCard({
    required String personaId,
    required String userMessage,
    required String kaiReply,
    required Map<String, int> personalityDelta,
    required Map<String, int> moodDelta,
    required List<String> tags,
    required String mbti,
    required List<String> memoriesUsed,
    required bool webSearchUsed,
    String? curiosityQuestion,
    int inputTokens   = 0,
    int outputTokens  = 0,
    double costUsd    = 0.0,
  }) async {
    if (_db == null) return;

    // Only save if there's something worth recording
    final hasDeltas = personalityDelta.values.any((v) => v != 0) ||
        moodDelta.values.any((v) => v != 0);
    final hasSignal = hasDeltas || tags.isNotEmpty || memoriesUsed.isNotEmpty || webSearchUsed;
    if (!hasSignal) return;

    try {
      final card = ActivityCard(
        id:               '',
        timestamp:        DateTime.now().millisecondsSinceEpoch,
        userMessage:      userMessage,
        kaiReply:         kaiReply,
        personalityDelta: personalityDelta,
        moodDelta:        moodDelta,
        tags:             tags,
        mbti:             mbti,
        memoriesUsed:     memoriesUsed,
        webSearchUsed:    webSearchUsed,
        curiosityQuestion: curiosityQuestion,
        inputTokens:      inputTokens,
        outputTokens:     outputTokens,
        costUsd:          costUsd,
      );

      await _db!.ref('kai/$personaId/activity_cards').push().set(card.toJson());
    } catch (e) {
      print('🃏 [ActivityCard] Failed to save: $e');
    }
  }

  /// Load last [limit] cards, newest first.
  Future<List<ActivityCard>> getCards(String personaId, {int limit = 60}) async {
    if (_db == null) return [];
    try {
      final snap = await _db!
          .ref('kai/$personaId/activity_cards')
          .orderByKey()
          .limitToLast(limit)
          .get();

      if (!snap.exists || snap.value == null) return [];

      final raw = Map<String, dynamic>.from(snap.value as Map);
      final cards = raw.entries.map((e) {
        return ActivityCard.fromJson(e.key, Map<dynamic, dynamic>.from(e.value as Map));
      }).toList();

      // newest first
      cards.sort((a, b) => b.timestamp.compareTo(a.timestamp));
      return cards;
    } catch (e) {
      print('🃏 [ActivityCard] Failed to load: $e');
      return [];
    }
  }
}
