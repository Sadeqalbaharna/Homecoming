// ProjectRegistryService
//
// Kai's map of the worlds he oversees — the "god brain" registry.
// Backed by the default (homecoming-74f73) RTDB at /projects/{projectId}.
//
// This is the run-time equivalent of how an agent enumerates the folders it
// can enter: Kai reads this list to know which projects exist, their status
// (namespaced under Homecoming vs graduated to their own Firebase project),
// and where their code / data live.
//
// Rules: /projects is readable by any signed-in session. Writes are intended
// to be god-gated (see database.rules.json); during the current single-owner
// phase they are allowed for any signed-in session so the app can manage the
// registry directly. Tighten to the god uid when a permanent login lands.
library;

import 'package:firebase_database/firebase_database.dart';

/// One project ("world") in Kai's registry.
class ProjectEntry {
  final String id; // registry key, e.g. "kingdom"
  final String name; // display name, e.g. "Kingdom / Tavern"
  final String status; // "namespaced" | "graduated"
  final String? firebase; // firebase project id, null if namespaced
  final String? rtdb; // realtime database url, if any
  final String? repoPath; // local code path
  final String summary; // one-line description
  final int createdAt; // ms since epoch
  final int updatedAt; // ms since epoch

  const ProjectEntry({
    required this.id,
    required this.name,
    this.status = 'namespaced',
    this.firebase,
    this.rtdb,
    this.repoPath,
    this.summary = '',
    this.createdAt = 0,
    this.updatedAt = 0,
  });

  factory ProjectEntry.fromMap(String id, Map<dynamic, dynamic> m) {
    return ProjectEntry(
      id: id,
      name: (m['name'] ?? id).toString(),
      status: (m['status'] ?? 'namespaced').toString(),
      firebase: m['firebase']?.toString(),
      rtdb: m['rtdb']?.toString(),
      repoPath: m['repoPath']?.toString(),
      summary: (m['summary'] ?? '').toString(),
      createdAt: (m['createdAt'] is int) ? m['createdAt'] as int : 0,
      updatedAt: (m['updatedAt'] is int) ? m['updatedAt'] as int : 0,
    );
  }

  Map<String, dynamic> toMap() => {
        'name': name,
        'status': status,
        if (firebase != null && firebase!.isNotEmpty) 'firebase': firebase,
        if (rtdb != null && rtdb!.isNotEmpty) 'rtdb': rtdb,
        if (repoPath != null && repoPath!.isNotEmpty) 'repoPath': repoPath,
        'summary': summary,
        'createdAt': createdAt,
        'updatedAt': updatedAt,
      };

  ProjectEntry copyWith({
    String? name,
    String? status,
    String? firebase,
    String? rtdb,
    String? repoPath,
    String? summary,
    int? createdAt,
    int? updatedAt,
  }) =>
      ProjectEntry(
        id: id,
        name: name ?? this.name,
        status: status ?? this.status,
        firebase: firebase ?? this.firebase,
        rtdb: rtdb ?? this.rtdb,
        repoPath: repoPath ?? this.repoPath,
        summary: summary ?? this.summary,
        createdAt: createdAt ?? this.createdAt,
        updatedAt: updatedAt ?? this.updatedAt,
      );
}

class ProjectRegistryService {
  static final ProjectRegistryService _instance =
      ProjectRegistryService._internal();
  factory ProjectRegistryService() => _instance;
  ProjectRegistryService._internal();

  DatabaseReference get _root => KaiDb.instance.ref('projects');

  /// Live stream of all registered projects, sorted by name.
  Stream<List<ProjectEntry>> watch() {
    return _root.onValue.map((event) {
      final val = event.snapshot.value;
      if (val is! Map) return <ProjectEntry>[];
      final list = <ProjectEntry>[];
      val.forEach((key, v) {
        if (v is Map) list.add(ProjectEntry.fromMap(key.toString(), v));
      });
      list.sort((a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase()));
      return list;
    });
  }

  /// One-shot read.
  Future<List<ProjectEntry>> fetchOnce() async {
    final snap = await _root.get();
    final val = snap.value;
    if (val is! Map) return <ProjectEntry>[];
    final list = <ProjectEntry>[];
    val.forEach((key, v) {
      if (v is Map) list.add(ProjectEntry.fromMap(key.toString(), v));
    });
    list.sort((a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase()));
    return list;
  }

  /// Create or update a project. Uses the entry's id as the registry key.
  /// Sets createdAt on first write and always refreshes updatedAt.
  Future<void> upsert(ProjectEntry entry) async {
    final now = DateTime.now().millisecondsSinceEpoch;
    final ref = _root.child(entry.id);
    final existing = await ref.get();
    final created = (existing.exists &&
            existing.child('createdAt').value is int &&
            (existing.child('createdAt').value as int) > 0)
        ? existing.child('createdAt').value as int
        : now;
    await ref.set(entry.copyWith(createdAt: created, updatedAt: now).toMap());
  }

  /// Remove a project from the registry (does not touch its data).
  Future<void> remove(String id) => _root.child(id).remove();

  /// Normalize a display name into a safe registry key (RTDB keys can't
  /// contain . $ # [ ] / or control chars).
  static String keyFor(String name) {
    final k = name
        .trim()
        .toLowerCase()
        .replaceAll(RegExp(r'[.$#\[\]/\s]+'), '_')
        .replaceAll(RegExp(r'_+'), '_')
        .replaceAll(RegExp(r'^_|_$'), '');
    return k.isEmpty ? 'project_${DateTime.now().millisecondsSinceEpoch}' : k;
  }
}
