// BrainBackfill
// Reads historical conversation turns from Firebase and runs brain extraction
// on each pair, seeding the knowledge graph retroactively.
//
// Usage:
//   final result = await BrainBackfill.run(personaId);
//
// Rate-limited: 3 pairs per batch with 800ms delay to avoid hammering GPT.

library;

import 'package:firebase_database/firebase_database.dart';
import '../services/core/brain_extraction_service.dart';
import '../services/core/firebase_service.dart';

class BrainBackfillResult {
  final int processed;
  final int written;
  final int skipped;
  BrainBackfillResult({
    required this.processed,
    required this.written,
    required this.skipped,
  });
}

class BrainBackfill {
  static Future<BrainBackfillResult> run(
    String personaId, {
    int batchSize = 3,
    void Function(String status)? onProgress,
  }) async {
    if (!FirebaseService.isAvailable) {
      return BrainBackfillResult(processed: 0, written: 0, skipped: 0);
    }

    onProgress?.call('Loading conversation history…');

    // Load raw conversation messages
    final snap = await KaiDb.instance
        .ref('conversations/$personaId')
        .get();

    final snapValue = snap.value;
    if (!snap.exists || snapValue == null) {
      return BrainBackfillResult(processed: 0, written: 0, skipped: 0);
    }

    // Parse into (userMsg, kaiReply) pairs
    final pairs = _parsePairs(snapValue);
    if (pairs.isEmpty) {
      return BrainBackfillResult(processed: 0, written: 0, skipped: 0);
    }

    onProgress?.call('Found ${pairs.length} conversation turns. Extracting…');

    final brain = BrainExtractionService();
    int processed = 0;
    int written = 0;
    int skipped = 0;

    // Process in batches
    for (var i = 0; i < pairs.length; i += batchSize) {
      final batch = pairs.sublist(
        i,
        (i + batchSize).clamp(0, pairs.length),
      );

      await Future.wait(batch.map((pair) async {
        try {
          await brain.extractAndMerge(
            personaId: personaId,
            userMessage: pair.$1,
            aiReply: pair.$2,
          );
          written++;
        } catch (e) {
          skipped++;
          print('⚠️ [BrainBackfill] pair failed: $e');
        }
        processed++;
      }));

      onProgress?.call(
          'Processed ${processed.clamp(0, pairs.length)} / ${pairs.length} turns…');

      // Rate-limit between batches
      if (i + batchSize < pairs.length) {
        await Future.delayed(const Duration(milliseconds: 800));
      }
    }

    return BrainBackfillResult(
      processed: processed,
      written: written,
      skipped: skipped,
    );
  }

  /// Parses Firebase conversation data into (userMsg, kaiReply) pairs.
  /// Handles both List<dynamic> and Map<dynamic,dynamic> shapes.
  static List<(String, String)> _parsePairs(Object raw) {
    final messages = <String>[];

    if (raw is List) {
      for (final item in raw) {
        if (item is String) messages.add(item);
      }
    } else if (raw is Map) {
      // Firebase may store as a map keyed by push ID or index
      final values = raw.values.toList();
      // Each entry may be a map with 'messages' list, or a flat string
      for (final v in values) {
        if (v is String) {
          messages.add(v);
        } else if (v is Map) {
          final msgs = v['messages'];
          if (msgs is List) {
            for (final m in msgs) {
              if (m is String) messages.add(m);
            }
          }
        }
      }
    }

    // Sort by timestamp prefix if present: "[1234567890] User: ..."
    messages.sort((a, b) {
      final tsA = _extractTimestamp(a);
      final tsB = _extractTimestamp(b);
      return tsA.compareTo(tsB);
    });

    // Pair consecutive User: / Kai: lines
    final pairs = <(String, String)>[];
    String? pendingUser;

    for (final msg in messages) {
      final clean = _stripTimestamp(msg);
      if (clean.startsWith('User: ')) {
        pendingUser = clean.substring(6);
      } else if (clean.startsWith('Kai: ') && pendingUser != null) {
        pairs.add((pendingUser!, clean.substring(5)));
        pendingUser = null;
      }
    }

    return pairs;
  }

  static int _extractTimestamp(String msg) {
    final match = RegExp(r'^\[(\d+)\]').firstMatch(msg);
    return match != null ? int.tryParse(match.group(1)!) ?? 0 : 0;
  }

  static String _stripTimestamp(String msg) {
    return msg.replaceFirst(RegExp(r'^\[\d+\]\s*'), '');
  }
}
