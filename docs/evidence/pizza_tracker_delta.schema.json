{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homecoming://schemas/pizza-tracker-delta-v1",
  "title": "Governed Pizza tracker delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deltaId", "createdAt", "sourceOfTruthRef", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deltaId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceOfTruthRef": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "projectId", "requestedState", "authorityOwner", "riskClass", "sourceOfTruthRef", "changedSurfaces", "evidence"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{3,127}$" },
          "projectId": {
            "enum": ["homecoming_northstar", "hoard_northstar", "kingdom_northstar", "factory_northstar", "tiktok_portfolio_manager"]
          },
          "requestedState": {
            "enum": ["queued", "ready", "active", "repairing", "evidence_review", "verified", "awaiting_sponsor", "blocked", "deferred"]
          },
          "authorityOwner": { "enum": ["agent", "sponsor"] },
          "riskClass": { "enum": ["local_safe", "product_decision", "live_external", "destructive", "security_sensitive", "costly"] },
          "sourceOfTruthRef": { "type": "string", "minLength": 1 },
          "changedSurfaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
                "kind": { "enum": ["git_commit", "file_sha256", "test_result", "reported_external", "sponsor_decision"] },
                "repositoryRoot": { "type": "string" },
                "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "authorityId": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
