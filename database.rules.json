{
  "rules": {
    "conversations": {
      "$personaId": {
        ".read": true,
        ".write": true,
        "$conversationId": {
          ".validate": "newData.hasChildren(['userMessage', 'aiResponse', 'timestamp'])"
        }
      }
    },
    "personalities": {
      "$personaId": {
        ".read": true,
        ".write": true
      }
    },
    "memory": {
