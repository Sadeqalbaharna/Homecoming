{
  "rules": {
    ".read": false,
    ".write": false,

    "config": {
      ".read": false,
      ".write": false
    },

    "projects": {
      ".read": "auth != null",
      "$projectId": {
        ".write": "auth != null"
      }
    },

    "conversations": {
      "$personaId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"],
        "$conversationId": {
          ".validate": "newData.hasChildren(['userMessage', 'aiResponse', 'timestamp'])"
        }
      }
    },
    "knowledge_graph": {
      "$personaId": { ".read": "auth != null", ".write": "auth != null" }
    },
    "knowledge_graphs": {
      "$personaId": { ".read": "auth != null", ".write": "auth != null" }
    },
    "knowledge_graph_archive": {
      "$personaId": { ".read": "auth != null", ".write": "auth != null" }
    },
    "personalities": {
      "$personaId": { ".read": "auth != null", ".write": "auth != null" }
    },
    "personas": {
      "$personaId": { ".read": "auth != null", ".write": "auth != null" }
    },
    "memory": {
      "buffers":    { "$personaId": { ".read": "auth != null", ".write": "auth != null" } },
      "shards":     { "$personaId": { ".read": "auth != null", ".write": "auth != null" } },
      "embeddings": { "$personaId": { ".read": "auth != null", ".write": "auth != null" } },
      "facts":      { "$personaId": { ".read": "auth != null", ".write": "auth != null" } },
      "daily":      { "$personaId": { ".read": "auth != null", ".write": "auth != null" } }
    },
    "kai": {
      "$personaId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "journal":          { ".indexOn": ["timestamp"] },
        "emotional_events": { ".indexOn": ["timestamp"] },
        "proactive_queue":  { ".indexOn": ["delivered"] }
      }
    },
    "home_automation": {
      "$personaId": { ".read": "auth != null", ".write": "auth != null" }
    },
    "devices":   { ".read": "auth != null", ".write": "auth != null" },
    "usage":     { ".read": "auth != null", ".write": "auth != null" },
    "analytics": { ".read": "auth != null", ".write": "auth != null" }
  }
}
