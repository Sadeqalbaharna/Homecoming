{
  "rules": {
    "conversations": {
      "$personaId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["timestamp"],
        "$conversationId": {
          ".validate": "newData.hasChildren(['userMessage', 'aiResponse', 'timestamp'])"
        }
      }
    },
    "knowledge_graphs": {
      "$personaId": {
        ".read": true,
        ".write": true
      }
    },
    "personalities": {
      "$personaId": {
        ".read": true,
        ".write": true
      }
    },
    "memory": {
      "buffers": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "shards": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "embeddings": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "facts": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "daily": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "analytics": {
      ".read": true,
      ".write": true
    },
    "home_automation": {
      "$personaId": {
        ".read": true,
        ".write": true,
        "commands": {
          "$commandId": {
            ".read": true,
            ".write": true
          }
        },
        "status": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
