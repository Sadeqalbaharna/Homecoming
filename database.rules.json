{
  "rules": {
    "conversations": {
      "$personaId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["timestamp"],
        "$conversationId": {
          ".validate": "newData.hasChildren(['userMessage', 'aiResponse', 'timestamp'])"
        }
      }
    },
    "knowledge_graphs": {
      "$personaId": {
        ".read": true,
        ".write": true
      }
    },
    "personalities": {
      "$personaId": {
        ".read": true,
        ".write": true
      }
    },
    "memory": {
      "buffers": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "shards": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "embeddings": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "facts": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "daily": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "kai": {
      "$personaId": {
        ".read": true,
        ".write": true,
        "journal": {
          ".indexOn": ["timestamp"]
        },
        "emotional_events": {
          ".indexOn": ["timestamp"]
        },
        "state": {
          ".read": true,
          ".write": true
        },
        "proactive_queue": {
          ".indexOn": ["delivered"]
        }
      }
    },
    "analytics": {
      ".read": true,
      ".write": true
    },
    "home_automation": {
      ".read": true,
      ".write": true
    }
  }
}
