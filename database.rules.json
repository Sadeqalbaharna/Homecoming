        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "shards": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "embeddings": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "facts": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      },
      "daily": {
        "$personaId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "analytics": {
      ".read": true,
      ".write": true
    }
  }
}
