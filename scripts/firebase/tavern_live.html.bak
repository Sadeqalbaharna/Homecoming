<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>⚔ The Tavern — Live Floor</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:#0a0604;color:#f0d080;font-family:'Courier New',monospace;
     display:flex;height:100vh;overflow:hidden;user-select:none}
#wrap{flex:1;display:flex;flex-direction:column;align-items:center;
      justify-content:center;gap:8px;padding:10px;overflow:hidden}
#topbar{display:flex;flex-direction:column;gap:6px;align-items:center}
#floor-btns,#add-tools{display:flex;gap:8px;align-items:center}
#floor-btns button,#add-tools button{background:#1a0f07;border:1px solid #4a3219;color:#f0d080;
  font-family:inherit;font-size:10px;padding:4px 10px;cursor:pointer;letter-spacing:1px}
#floor-btns button.active,#floor-btns button:hover,#add-tools button:hover{background:#2a1a08;border-color:#ffd700;color:#ffd700}
#add-tools{display:none;background:#140d06;border:1px solid #3a2510;padding:5px 10px;border-radius:4px}
#add-tools .lbl{color:#806040;font-size:9px;letter-spacing:1px}
#del-btn{border-color:#7a3020!important;color:#e07060!important}
#del-btn:hover{background:#3a1410!important;border-color:#e04020!important}
canvas{image-rendering:pixelated;image-rendering:crisp-edges;cursor:crosshair;
       border:2px solid #4a3219;box-shadow:0 0 40px rgba(200,120,30,.3)}
#sidebar{width:220px;min-width:220px;background:#100a05;border-left:2px solid #3a2510;
         padding:12px;overflow-y:auto;display:flex;flex-direction:column;gap:12px}
#sidebar h1{font-size:12px;color:#ffd700;letter-spacing:3px;text-transform:uppercase;
            border-bottom:1px solid #3a2510;padding-bottom:6px;text-align:center}
.sec{font-size:9px;color:#806040;letter-spacing:2px;text-transform:uppercase;margin-bottom:5px}
.stat{display:flex;justify-content:space-between;font-size:10px;margin-bottom:2px}
.stat-v{color:#ffd700}
.ti{background:#180e06;border:1px solid #2a1a08;border-radius:3px;padding:6px;
    margin-bottom:4px;font-size:9px;transition:all .25s}
.ti.occ{border-color:#c8a020;background:#221408}
.ti-name{color:#f0c060;font-weight:bold;margin-bottom:2px}
.ti-guest{color:#80d080;font-size:9px}
.ti-since{color:#604830;font-size:8px;margin-top:2px}
.dot{display:inline-block;width:5px;height:5px;border-radius:50%;margin-right:4px;vertical-align:middle}
.dot.on{background:#40c040;animation:blink 1.4s infinite}
.dot.off{background:#303030}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
#lasttap{background:#180e06;border:1px solid #2a1a08;border-radius:3px;padding:7px;font-size:9px;color:#c09050}
#clock{font-size:22px;color:#ffd700;text-align:center;letter-spacing:4px;margin-top:4px}
#dateline{font-size:9px;color:#806040;text-align:center;letter-spacing:1px;margin-top:2px}
#live-ind{font-size:9px;color:#40c040;text-align:center;letter-spacing:2px}
#tooltip{position:fixed;pointer-events:none;display:none;z-index:999;
  background:rgba(12,7,2,.93);border:1px solid #c8a020;color:#f0d080;
  font:10px 'Courier New',monospace;padding:7px 11px;border-radius:3px;line-height:1.7}
</style>
</head>
<body>

<div id="wrap">
  <div id="topbar">
    <div id="floor-btns">
      <span style="color:#806040;font-size:10px;letter-spacing:1px">FLOOR:</span>
      <button class="active" onclick="setFloor('gf')">Main Hall</button>
      <button onclick="setFloor('ff')">First Floor</button>
      <span id="live-ind">● LIVE</span>
      <span style="width:14px"></span>
      <button id="edit-btn" onclick="toggleEdit()">✎ Edit Layout</button>
      <button id="save-btn" onclick="saveLayout()" style="display:none">💾 Save</button>
      <button id="reset-btn" onclick="resetLayout()" style="display:none">↺ Reset</button>
    </div>
    <div id="add-tools">
      <span class="lbl">ADD TABLE:</span>
      <button onclick="addTable('2top')">2-Top</button>
      <button onclick="addTable('4top')">4-Top</button>
      <button onclick="addTable('communal')">Communal 6</button>
      <button onclick="addTable('banquet')">Banquet 8</button>
      <button onclick="addTable('wall2')">Nook 2</button>
      <span style="width:8px"></span>
      <button id="del-btn" onclick="deleteSelected()">🗑 Delete selected</button>
      <span class="lbl" style="margin-left:6px">· double-click a table to rename · Save syncs to RTDB</span>
    </div>
  </div>
  <canvas id="c"></canvas>
</div>

<div id="sidebar">
  <h1>⚔ The Tavern</h1>
  <div><div id="clock">--:--</div><div id="dateline">---</div></div>
  <div>
    <div class="sec">House</div>
    <div class="stat"><span>Guests</span><span class="stat-v" id="s-guests">0</span></div>
    <div class="stat"><span>Tables</span><span class="stat-v" id="s-tables">—</span></div>
  </div>
  <div><div class="sec">Tables</div><div id="tlist"></div></div>
  <div><div class="sec">Last Tap</div><div id="lasttap">No taps yet</div></div>
</div>

<div id="tooltip"></div>

<script>
const RTDB='https://kingdom-ac44f-default-rtdb.europe-west1.firebasedatabase.app';

/* ── Canvas ──────────────────────────────────────────────────────────────── */
const canvas=document.getElementById('c');
const ctx=canvas.getContext('2d');
ctx.imageSmoothingEnabled=false;
const CW=1056,CH=680;
canvas.width=CW;canvas.height=CH;
const WALL_H=128;

/* ── Palette ─────────────────────────────────────────────────────────────── */
/* ── Directional patron atlas — patrons_anim.png
   Layout: 4 walk-frames wide × 24 rows tall (6 chars × 4 dirs)
   Each frame: 35 × 34 px
   Row order per char: down(0), up(1), left(2), right(3)         ── */
const MS_FW=35,MS_FH=34,MS_FRAMES=4,MS_N=6;
const MS_DIR={down:0,up:1,left:2,right:3};
const msImg=new Image();let msReady=false;msImg.onload=function(){msReady=true;};
msImg.src='patrons_anim.png';
const WD=['#46270f','#603a1a','#825028','#aa703c','#c89456','#e0b074'];
const RD=['#5a1410','#841c16','#a82c22','#c84232','#e0604c'];
const P={
  wpA:'#7a4c28',wpB:'#6b4020',wpC:'#5e3618',
  fpA:'#c8924c',fpB:'#b0823c',fpC:'#d29a54',fpLine:'#7a3818',
  wall:'#3c2410',wallHi:'#5a3a1c',lanY:'#f0d040',lanO:'#e09020',
  skin:'#f0c890',outline:'#1a0c05',
  chars:[['#5c2010','#2850a8','#3a4858'],['#f0c040','#38883a','#5a4028'],
         ['#180e08','#a02020','#3c4020'],['#a08060','#703098','#283050'],
         ['#c03010','#e07020','#4a3818']],
};
function hashStr(s){let h=5381;for(const c of s)h=((h<<5)+h+c.charCodeAt(0))&0xffffffff;return Math.abs(h);}

/* ── Drawing helpers ─────────────────────────────────────────────────────── */
function R(x,y,w,h,fill,stroke,lw){x=Math.round(x);y=Math.round(y);w=Math.round(w);h=Math.round(h);
  if(fill){ctx.fillStyle=fill;ctx.fillRect(x,y,w,h);} if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=lw||1;ctx.strokeRect(x+.5,y+.5,w-1,h-1);}}
function gradV(x,y,w,h,c0,c1){x=Math.round(x);y=Math.round(y);w=Math.round(w);h=Math.round(h);
  const g=ctx.createLinearGradient(0,y,0,y+h);g.addColorStop(0,c0);g.addColorStop(1,c1);ctx.fillStyle=g;ctx.fillRect(x,y,w,h);}
function gradH(x,y,w,h,c0,c1){x=Math.round(x);y=Math.round(y);w=Math.round(w);h=Math.round(h);
  const g=ctx.createLinearGradient(x,0,x+w,0);g.addColorStop(0,c0);g.addColorStop(.5,c1);g.addColorStop(1,c0);ctx.fillStyle=g;ctx.fillRect(x,y,w,h);}
function contactShadow(cx,cy,rw,rh){ctx.save();ctx.globalAlpha=.22;ctx.fillStyle='#000';ctx.beginPath();ctx.ellipse(cx,cy,rw,rh,0,0,Math.PI*2);ctx.fill();ctx.restore();}
function candle(cx,cy){cx=Math.round(cx);cy=Math.round(cy);R(cx-1,cy-3,3,7,'#e8e0cc',P.outline);ctx.fillStyle='#ffb648';ctx.fillRect(cx,cy-5,1,2);ctx.fillStyle='#ffe896';ctx.fillRect(cx,cy-6,1,1);}
function glow(cx,cy,r){const g=ctx.createRadialGradient(cx,cy,0,cx,cy,r||9);g.addColorStop(0,'rgba(255,180,70,.40)');g.addColorStop(1,'rgba(255,180,70,0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(cx,cy,r||9,0,Math.PI*2);ctx.fill();}
function plate(cx,cy){cx=Math.round(cx);cy=Math.round(cy);ctx.fillStyle='#e8e0cc';ctx.beginPath();ctx.ellipse(cx,cy,5,3,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#b8ac94';ctx.lineWidth=.7;ctx.stroke();ctx.fillStyle='#c44a30';ctx.beginPath();ctx.ellipse(cx,cy,2,1.2,0,0,Math.PI*2);ctx.fill();}
function chairBack(cx,y,w,h){const x=cx-w/2,r=Math.max(2,h/3);R(x,y,w,r,WD[2],P.outline);gradV(x,y+r,w,h-r,RD[3],RD[1]);R(x,y+r,w,h-r,null,P.outline);}
function chairSeat(cx,y,w,h){const x=cx-w/2;gradV(x,y,w,h,RD[3],RD[1]);R(x,y,w,h,null,P.outline);ctx.fillStyle=RD[4];ctx.fillRect(Math.round(x)+1,Math.round(y)+1,Math.round(w)-2,1);R(x,y+h,w,Math.max(2,h/3),WD[2],P.outline);ctx.fillStyle=WD[0];ctx.fillRect(Math.round(x)+1,Math.round(y+h)+Math.round(h/3),2,3);ctx.fillRect(Math.round(x+w)-3,Math.round(y+h)+Math.round(h/3),2,3);}

/* ── Scale config (px per mm; First Floor is rotated to fit, so larger) ──── */
let PXMM=0.0961;
const PXMM_GF=0.0961, PXMM_FF=0.055;   // FF natural orientation (full floor to scale)
const GF_WALLS=[[26,128,1030,128],[26,128,26,629],[1030,128,1030,629],[26,629,1030,629],[349,128,349,548]];
// A 4-top is two 2-tops pushed together; banquet vertical (rot:90); nook against wall.
const GF_DEFAULT=[
  {id:'T01',name:'Table 1',type:'4top',cx:90, cy:232,rot:0},
  {id:'T02',name:'Table 2',type:'4top',cx:90, cy:419,rot:0},
  {id:'T03',name:'Table 3',type:'2top',cx:320,cy:231,rot:0},
  {id:'T04',name:'Table 4',type:'2top',cx:320,cy:409,rot:0},
  {id:'T05',name:'Banquet',type:'banquet',cx:500,cy:347,rot:90},
  {id:'T06',name:'Table 6',type:'4top',cx:697,cy:185,rot:0},
  {id:'T07',name:'Table 7',type:'4top',cx:865,cy:185,rot:0},
  {id:'T08',name:'Table 8',type:'4top',cx:697,cy:363,rot:0},
  {id:'T09',name:'Table 9',type:'4top',cx:865,cy:363,rot:0},
  {id:'T10',name:'Nook', type:'wall2', cx:1000,cy:347,rot:90},
];
// First floor: full floor to scale, natural orientation. Kitchen is blocked out
// as one zone on the left; guest seating sits on the right.
const FF_WALLS=[[164,128,892,128],[164,128,164,680],[892,128,892,680],[164,680,892,680],[657,128,657,680]];
const FF_DEFAULT=[
  {id:'F01',name:'Lounge 1',type:'4top',cx:699,cy:169,rot:0},
  {id:'F02',name:'Lounge 2',type:'4top',cx:812,cy:169,rot:0},
  {id:'F03',name:'Lounge 3',type:'2top',cx:711,cy:283,rot:90},
  {id:'F04',name:'Lounge 4',type:'2top',cx:711,cy:429,rot:90},
  {id:'F05',name:'Lounge 5',type:'4top',cx:834,cy:266,rot:0},
  {id:'F06',name:'Lounge 6',type:'4top',cx:834,cy:473,rot:0},
  {id:'F07',name:'Lounge 7',type:'4top',cx:752,cy:560,rot:0},
  {id:'F08',name:'Lounge 8',type:'2top',cx:858,cy:360,rot:90},
];
let GF_TABLES=JSON.parse(JSON.stringify(GF_DEFAULT));
let FF_TABLES=JSON.parse(JSON.stringify(FF_DEFAULT));

let currentFloor='gf';
let floorData={tables:{},guests:{}};
let animFrame=0,lastRender=0,idSeq=1;

/* ── Walk animation state ────────────────────────────────────────────────────
   guestWalk: { uid → { state, x, y, ox, oy, tx, ty, name, startMs } }
   state: 'walking_in' | 'seated' | 'walking_out'
   Walk-in : terrace door → table  (WALK_MS_IN ms)
   Seated  : sprite shown at table while visit is active
   Walk-out: table → terrace door (WALK_MS_OUT ms), then entry deleted      */
const WALK_MS_IN  = 2200;  // arrival walk duration
const WALK_MS_OUT = 1800;  // departure walk duration (slightly faster)
const SPAWN_X     = 1030;  // terrace door x
const SPAWN_Y     = 755;   // terrace door centre y
const guestWalk   = {};    // uid → walker entry

function _tablePos(tableId){
  const all=[...GF_TABLES,...FF_TABLES];
  return all.find(t=>t.id===tableId)||null;
}

function _walkDir(dx,dy){
  if(Math.abs(dx)>Math.abs(dy)) return dx<0?'left':'right';
  return dy<0?'up':'down';
}

/** Call whenever active_guests snapshot changes. */
function syncGuestWalk(newGuests){
  const now=performance.now();

  // ── Departures: start walk-out instead of instant delete ──────────────
  for(const [uid,w] of Object.entries(guestWalk)){
    if(newGuests[uid]) continue;              // still present
    if(w.state==='walking_out') continue;     // already heading out
    // Start walk-out from wherever they currently are
    w.ox=w.x; w.oy=w.y;
    w.tx=SPAWN_X; w.ty=SPAWN_Y;
    w.state='walking_out';
    w.startMs=now;
  }

  // ── Arrivals: spawn and begin walk-in ─────────────────────────────────
  for(const [uid,g] of Object.entries(newGuests||{})){
    if(guestWalk[uid]){
      // Edge case: guest re-tapped while walking out — cancel exit walk
      if(guestWalk[uid].state==='walking_out'){
        const tbl=_tablePos(g.tableId);
        if(tbl){
          const w=guestWalk[uid];
          w.ox=w.x; w.oy=w.y;
          w.tx=tbl.cx; w.ty=tbl.cy;
          w.state='walking_in';
          w.startMs=now;
        }
      }
      continue;
    }
    const tbl=_tablePos(g.tableId);
    if(!tbl) continue;
    guestWalk[uid]={
      state:'walking_in',
      x:SPAWN_X, y:SPAWN_Y,
      ox:SPAWN_X, oy:SPAWN_Y,
      tx:tbl.cx,  ty:tbl.cy,
      name:g.name||g.guestName||'Guest',
      startMs:now,
    };
  }
}

/** Advance all walkers one frame — call every render. */
function stepGuests(){
  const now=performance.now();
  for(const uid of Object.keys(guestWalk)){
    const w=guestWalk[uid];
    if(w.state==='seated') continue;

    const dur=w.state==='walking_in'?WALK_MS_IN:WALK_MS_OUT;
    const t=Math.min(1,(now-w.startMs)/dur);
    // smooth-step easing
    const s=t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
    w.x=w.ox+(w.tx-w.ox)*s;
    w.y=w.oy+(w.ty-w.oy)*s;

    if(t>=1){
      if(w.state==='walking_in'){
        w.x=w.tx; w.y=w.ty;
        w.state='seated';
      } else {
        // reached exit — remove
        delete guestWalk[uid];
      }
    }
  }
}

/** Draw only moving walkers (walking_in / walking_out).
 *  Seated guests are drawn by the table rendering once walk-in completes. */
function drawWalkingGuests(){
  for(const w of Object.values(guestWalk)){
    if(w.state==='seated') continue;   // table renderer handles this
    const dir = w.state==='walking_in'
      ? _walkDir(w.tx-w.x, w.ty-w.y)
      : _walkDir(SPAWN_X-w.x, SPAWN_Y-w.y);
    drawGuest(w.x, w.y, w.name, dir);
  }
}
function curTables(){return currentFloor==='gf'?GF_TABLES:FF_TABLES;}
function setCurTables(a){if(currentFloor==='gf')GF_TABLES=a;else FF_TABLES=a;}
function curWalls(){return currentFloor==='gf'?GF_WALLS:FF_WALLS;}
function tableById(id){return curTables().find(t=>t.id===id)||null;}

/* ── Footprint + hit-test bbox (canvas px) ───────────────────────────────── */
const PAIR={W:480,D:600,gap:3};   // each half of a 4-top
function tbbox(t){
  const horiz=(t.rot%180)===0; let halfW,halfH;
  if(t.type==='4top'){
    const w=PAIR.W*PXMM, top=PAIR.D*PXMM*0.5, fh=750*PXMM*0.42, ch=430*PXMM*0.7;
    const span=w*2+PAIR.gap, tall=(top+fh)+ch*2;
    if(horiz){halfW=span/2+6; halfH=tall/2+6;} else {halfW=tall/2+6; halfH=span/2+6;}
  }else if(t.type==='2top'){
    const w=600*PXMM, top=600*PXMM*0.5, fh=750*PXMM*0.42, ch=430*PXMM*0.7;
    if(horiz){halfW=w/2+6; halfH=(top+fh)/2+ch+6;} else {halfW=(top+fh)/2+ch+6; halfH=w/2+6;}
  }else if(t.type==='banquet'){
    const tw=900*PXMM, th=1700*PXMM, ext=430*PXMM*0.8;
    if(horiz){halfW=th/2+ext; halfH=tw/2+34;} else {halfW=tw/2+ext; halfH=th/2+24;}
  }else if(t.type==='communal'){
    const tw=1900*PXMM, top=900*PXMM*0.5, fh=750*PXMM*0.42, ch=430*PXMM*0.7;
    if(horiz){halfW=tw/2+6; halfH=(top+fh)/2+ch+6;} else {halfW=(top+fh)/2+ch+6; halfH=tw/2+6;}
  }else if(t.type==='wall2'){
    const tw=450*PXMM, th=1000*PXMM, ext=430*PXMM*0.8;
    halfW=tw/2+ext; halfH=th/2+10;
  }else{ // bar
    const tw=420*PXMM*2.0; halfW=tw/2+4; halfH=40;
  }
  return {x0:t.cx-halfW,y0:t.cy-halfH,x1:t.cx+halfW,y1:t.cy+halfH};
}

/* ── Table renderers (param-based, oblique 2.5D) ─────────────────────────── */
function tableH(cx,cy,Wmm,Dmm,seats,ends,occ,guests,tag){
  const tw=Wmm*PXMM, top=Math.max(11,Dmm*PXMM*0.5), fh=Math.max(10,750*PXMM*0.42);
  const x=cx-tw/2, yt=cy-(top+fh)/2;
  const cw=tw/seats*0.74, cbh=Math.max(8,430*PXMM*0.7), csh=Math.max(7,430*PXMM*0.55);
  contactShadow(cx,yt+top+fh+10,tw/2+6,6);
  for(let i=0;i<seats;i++) chairBack(x+tw*(i+0.5)/seats,yt-cbh,cw,cbh);
  if(ends) chairBack(cx,yt-cbh,tw*0.5,cbh);
  gradV(x,yt,tw,top,WD[4],WD[2]);R(x,yt,tw,top,null,P.outline);
  ctx.fillStyle=WD[5];ctx.fillRect(Math.round(x)+1,Math.round(yt),Math.round(tw)-2,1);
  gradV(x,yt+top,tw,fh,WD[2],WD[0]);R(x,yt+top,tw,fh,null,P.outline);
  for(let vx=x+6;vx<x+tw-2;vx+=8){ctx.strokeStyle=WD[0];ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(Math.round(vx)+.5,yt+top+1);ctx.lineTo(Math.round(vx)+.5,yt+top+fh-1);ctx.stroke();}
  R(x+2,yt+top+fh,3,4,WD[0]);R(x+tw-5,yt+top+fh,3,4,WD[0]);
  for(let i=0;i<seats;i++){const sx=x+tw*(i+0.5)/seats;(seats===1||i===Math.floor(seats/2))?candle(sx,yt+top/2):plate(sx,yt+top/2);}
  for(let i=0;i<seats;i++) chairSeat(x+tw*(i+0.5)/seats,yt+top+fh+2,cw,csh);
  if(ends) chairSeat(cx,yt+top+fh+2,tw*0.5,csh);
  for(let i=0;i<seats;i++) if(seats===1||i===Math.floor(seats/2)) glow(x+tw*(i+0.5)/seats,yt+top/2-2,9);
  if(occ){let gi=0;const fy=yt+top+fh+csh+6;for(let i=0;i<seats&&gi<guests.length;i++) drawGuest(x+tw*(i+0.5)/seats,fy,guests[gi++],'up');}
  if(occ&&tag) nameTag(cx,yt-cbh-10,tag);
}
function tableV(cx,cy,Wmm,Lmm,seats,ends,occ,guests,tag,leftOnly){
  const tw=Wmm*PXMM, th=Lmm*PXMM, fh=Math.max(9,750*PXMM*0.40);
  const x=cx-tw/2, y=cy-(th+fh)/2;
  const chw=Math.max(8,430*PXMM*0.7), chh=th/seats*0.72;
  contactShadow(cx,y+th+fh+6,tw/2+7,6);
  for(let i=0;i<seats;i++){const sy=y+th*(i+0.5)/seats;chairSeat(x-chw/2-1,sy-chh/2,chw,chh);if(!leftOnly) chairSeat(x+tw+chw/2+1,sy-chh/2,chw,chh);}
  gradH(x,y,tw,th,WD[2],WD[4]);R(x,y,tw,th,null,P.outline);
  ctx.fillStyle=WD[5];ctx.fillRect(Math.round(x)+1,Math.round(y),Math.round(tw)-2,1);
  if(ends){gradV(x+tw*0.26,y+2,tw*0.48,th-4,RD[3],RD[1]);R(x+tw*0.26,y+2,tw*0.48,th-4,null,'#967828');}
  gradV(x,y+th,tw,fh,WD[2],WD[0]);R(x,y+th,tw,fh,null,P.outline);
  R(x+2,y+th+fh,3,4,WD[0]);R(x+tw-5,y+th+fh,3,4,WD[0]);
  if(ends){chairBack(cx,y-chw,tw*0.6,chw);chairSeat(cx,y+th+fh+2,tw*0.6,chh*0.6);}
  for(let i=0;i<seats;i++) candle(cx,y+th*(i+0.5)/seats);
  for(let i=0;i<seats;i++) glow(cx,y+th*(i+0.5)/seats,8);
  if(occ){let gi=0;for(let i=0;i<seats&&gi<guests.length;i++){drawGuest(x-chw/2-1,y+th*(i+0.5)/seats+8,guests[gi++],'right');if(gi<guests.length)drawGuest(x+tw+chw/2+1,y+th*(i+0.5)/seats+8,guests[gi++],'left');}}
  if(occ&&tag) nameTag(cx,y-chw-6,tag);
}
function draw4Top(t,occ,guests){
  const horiz=(t.rot%180)===0;
  const w=PAIR.W*PXMM, off=(w+PAIR.gap)/2;
  const g1=guests.slice(0,Math.ceil(guests.length/2)), g2=guests.slice(Math.ceil(guests.length/2));
  if(horiz){tableH(t.cx-off,t.cy,PAIR.W,PAIR.D,1,false,occ,g1,'');tableH(t.cx+off,t.cy,PAIR.W,PAIR.D,1,false,occ,g2,'');}
  else{const top=PAIR.D*PXMM*0.5,fh=750*PXMM*0.42,ch=430*PXMM*0.7;const offv=(top+fh)/2+ch/2+2;
       tableH(t.cx,t.cy-offv,PAIR.W,PAIR.D,1,false,occ,g1,'');tableH(t.cx,t.cy+offv,PAIR.W,PAIR.D,1,false,occ,g2,'');}
  if(occ){const b=tbbox(t);nameTag(t.cx,b.y0-2,t.name);}
}
function drawBar(t){
  const tw=420*PXMM*2.0,TH=28,FH=24;const x=t.cx-tw/2,y=t.cy-(TH+FH)/2;
  contactShadow(t.cx,y+TH+FH+6,tw/2,6);
  gradV(x,y,tw,TH,'#c4903c','#9a6c28');R(x,y,tw,TH,null,P.outline);
  gradV(x,y+TH,tw,FH,'#7a4c20','#5a3416');R(x,y+TH,tw,FH,null,P.outline);
  for(let px=x+12;px<x+tw-12;px+=46) R(px,y+TH+4,16,FH-8,'#5a3418',P.outline);
  drawStanding(t.cx,y-6,'Kai');              // Kai the bartender — he/him/his
  nameTag(t.cx,y-22,t.name);
}
function nameTag(cx,ty,label){ctx.font='bold 9px monospace';ctx.textAlign='center';const tw=ctx.measureText(label).width+10;R(cx-tw/2,ty,tw,13,'rgba(12,7,2,.88)','#c8a020',1);ctx.fillStyle='#ffd700';ctx.fillText(label,cx,ty+10);ctx.textAlign='left';}
// To-scale customer sprite — [hair, skin, shirt, pants]
const CPALS=[['#4a2a16','#f0c896','#2850a8','#3a4658'],['#1c1410','#d2966e','#a82828','#3c3c42'],
             ['#d2aa46','#f4d2aa','#388c50','#5a422c'],['#967860','#be8260','#7846a0','#283450'],
             ['#3c281e','#fad7b4','#d2782a','#463828']];
function drawGuest(cx,gy,name,dir){   // directional patron sprite; procedural fallback below
  if(msReady){
    const ci=hashStr(name||'Guest')%MS_N;
    const di=MS_DIR[dir]??0;
    const wf=animFrame%MS_FRAMES;          // walk-cycle frame (0-3)
    const sx=wf*MS_FW;                     // frame column
    const sy=(ci*4+di)*MS_FH;             // character+direction row
    const th=Math.max(36,Math.round(840*PXMM)),s=th/MS_FH,dw=MS_FW*s;
    ctx.drawImage(msImg,sx,sy,MS_FW,MS_FH,Math.round(cx-dw/2),Math.round(gy-th),Math.round(dw),Math.round(th));
    return;
  }
  const p=CPALS[hashStr(name||'Guest')%CPALS.length],hair=p[0],skin=p[1],shirt=p[2],pants=p[3];
  cx=Math.round(cx);gy=Math.round(gy);
  ctx.save();ctx.globalAlpha=.22;ctx.fillStyle='#000';ctx.beginPath();ctx.ellipse(cx,gy,8,3,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;ctx.restore();
  R(cx-7,gy-9,14,8,pants,P.outline,.8);
  R(cx-8,gy-22,16,14,shirt,P.outline,.9);ctx.fillStyle='rgba(255,255,255,.16)';ctx.fillRect(cx-7,gy-21,14,2);
  R(cx-11,gy-20,4,11,shirt,P.outline,.7);R(cx+7,gy-20,4,11,shirt,P.outline,.7);
  ctx.fillStyle=skin;ctx.fillRect(cx-2,gy-24,4,3);
  ctx.fillStyle=skin;ctx.beginPath();ctx.arc(cx,gy-29,6,0,Math.PI*2);ctx.fill();ctx.strokeStyle=P.outline;ctx.lineWidth=.8;ctx.stroke();
  ctx.fillStyle=hair;ctx.beginPath();ctx.arc(cx,gy-30,6,Math.PI,2*Math.PI);ctx.fill();ctx.fillRect(cx-6,gy-31,2,5);ctx.fillRect(cx+4,gy-31,2,5);
  ctx.fillStyle='#1a1008';ctx.fillRect(cx-3,gy-30,1,2);ctx.fillRect(cx+2,gy-30,1,2);
}
function drawStanding(cx,gy,name){   // standing customer (e.g. Kai the bartender — he/him)
  const p=CPALS[hashStr(name||'Guest')%CPALS.length],hair=p[0],skin=p[1],shirt=p[2],pants=p[3];
  cx=Math.round(cx);gy=Math.round(gy);
  ctx.save();ctx.globalAlpha=.22;ctx.fillStyle='#000';ctx.beginPath();ctx.ellipse(cx,gy,7,2.6,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;ctx.restore();
  R(cx-6,gy-13,5,12,pants,P.outline,.8);R(cx+1,gy-13,5,12,pants,P.outline,.8);
  ctx.fillStyle='#241a10';ctx.fillRect(cx-6,gy-2,5,2);ctx.fillRect(cx+1,gy-2,5,2);
  R(cx-8,gy-30,16,18,shirt,P.outline,.9);ctx.fillStyle='rgba(255,255,255,.16)';ctx.fillRect(cx-7,gy-29,14,2);
  R(cx-11,gy-29,4,15,shirt,P.outline,.7);R(cx+7,gy-29,4,15,shirt,P.outline,.7);
  ctx.fillStyle=skin;ctx.fillRect(cx-2,gy-33,4,3);
  ctx.fillStyle=skin;ctx.beginPath();ctx.arc(cx,gy-38,6,0,Math.PI*2);ctx.fill();ctx.strokeStyle=P.outline;ctx.lineWidth=.8;ctx.stroke();
  ctx.fillStyle=hair;ctx.beginPath();ctx.arc(cx,gy-39,6,Math.PI,2*Math.PI);ctx.fill();ctx.fillRect(cx-6,gy-40,2,5);ctx.fillRect(cx+4,gy-40,2,5);
  ctx.fillStyle='#1a1008';ctx.fillRect(cx-3,gy-39,1,2);ctx.fillRect(cx+2,gy-39,1,2);
}
function drawTable(t){
  const occ=!!(floorData.tables[t.id]&&floorData.tables[t.id].arrivedAt);
  const guests=getGuests(t.id);const on=occ||guests.length>0;const horiz=(t.rot%180)===0;
  if(t.type==='bar'){drawBar(t);return;}
  if(t.type==='4top'){draw4Top(t,on,guests);return;}
  if(t.type==='wall2'){tableV(t.cx,t.cy,450,1000,2,false,on,guests,t.name,true);return;}
  if(t.type==='banquet'){horiz?tableH(t.cx,t.cy,1700,900,3,true,on,guests,t.name):tableV(t.cx,t.cy,900,1700,3,true,on,guests,t.name,false);return;}
  if(t.type==='communal'){horiz?tableH(t.cx,t.cy,1900,900,3,false,on,guests,t.name):tableV(t.cx,t.cy,900,1900,3,false,on,guests,t.name,false);return;}
  // 2top
  horiz?tableH(t.cx,t.cy,600,600,1,false,on,guests,t.name):tableV(t.cx,t.cy,600,600,1,false,on,guests,t.name,false);
}

/* ── Back wall + floor ───────────────────────────────────────────────────── */
function drawBackWall(fr){
  for(let x=0;x<CW;x+=24){ctx.fillStyle=[P.wpA,P.wpB,P.wpC][Math.floor(x/24)%3];ctx.fillRect(x,0,24,WALL_H);ctx.fillStyle='#3a2010';ctx.fillRect(x,0,1,WALL_H);}
  R(0,0,CW,16,'#3a2010','#2a1008');ctx.fillStyle='#5a3018';ctx.fillRect(0,16,CW,3);
  R(0,72,CW,16,'#6a3c1c','#2a1008');ctx.fillStyle='#9a6040';ctx.fillRect(0,72,CW,3);
  const bc=['#2040a8','#20a040','#a02020','#a89020','#703098','#20a090','#c05020'];
  [60,92,124,300,332,560,592,820,852,884,940,972].forEach((bx,i)=>{const h=14+(i%4)*4;R(bx,72-h,9,h,bc[i%bc.length]);ctx.fillStyle='#ffffff18';ctx.fillRect(bx+1,72-h+5,7,2);});
  [150,420,690,930].forEach(sx=>drawLantern(sx,40,fr));
  const tvX=470,tvY=20,tvW=150,tvH=66;R(tvX-4,tvY-4,tvW+8,tvH+8,'#3a2010','#2a1008',2);R(tvX,tvY,tvW,tvH,'#102818','#2a1008');
  ctx.fillStyle='#20d060';ctx.font='bold 10px monospace';ctx.textAlign='center';ctx.fillText('⚔ THE TAVERN',tvX+tvW/2,tvY+tvH/2-2);
  ctx.font='8px monospace';ctx.fillStyle='#20d06088';ctx.fillText('● LIVE',tvX+tvW/2,tvY+tvH/2+10);ctx.textAlign='left';
  R(0,WALL_H-22,CW,22,'#5a3418','#3a1e0e');ctx.fillStyle='#8a5030';ctx.fillRect(0,WALL_H-22,CW,3);
}
function drawLantern(cx,cy,fr){const flk=.82+.18*Math.sin(fr*.09+cx*.01);
  const g=ctx.createRadialGradient(cx,cy+6,0,cx,cy+6,26);g.addColorStop(0,'rgba(240,180,40,'+(.26*flk)+')');g.addColorStop(1,'rgba(240,180,40,0)');
  ctx.fillStyle=g;ctx.fillRect(cx-26,cy-12,52,44);R(cx-6,cy,12,18,'#2a1408','#8a6020',1);
  ctx.fillStyle='rgba(240,180,40,'+(.65*flk)+')';ctx.fillRect(cx-4,cy+2,4,12);ctx.fillRect(cx+1,cy+2,3,12);
  ctx.fillStyle=P.lanY;ctx.fillRect(cx-1,cy+7,2,4);ctx.fillStyle=P.lanO;ctx.fillRect(cx-2,cy+5,4,3);}
function drawFloor(){const cols=[P.fpA,P.fpB,P.fpC];let py=WALL_H,ri=0;
  while(py<CH){ctx.fillStyle=cols[ri%3];ctx.fillRect(0,py,CW,22);ctx.fillStyle=P.fpLine;ctx.fillRect(0,py,CW,1);
    const k1=(ri*137+53)%CW;ctx.fillStyle='rgba(0,0,0,.10)';ctx.fillRect(k1,py+6,16,3);py+=22;ri++;}}
function drawWalls(){for(const w of curWalls()){ctx.strokeStyle=P.wall;ctx.lineWidth=(w[0]===w[2]&&Math.round(w[0])===349)?9:7;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(w[0],w[1]);ctx.lineTo(w[2],w[3]);ctx.stroke();
    ctx.strokeStyle=P.wallHi;ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(w[0],w[1]-2);ctx.lineTo(w[2],w[3]-2);ctx.stroke();}ctx.lineCap='butt';}

/* ── Fixtures: doors, entrances, stairs ──────────────────────────────────── */
// GF is to-scale (from the plan): stairs UP at the centre-left of the south
// wall, 1500mm double-door out to the terrace on the right wall.
const GF_FIX={stairs:[[134,260,629,'STAIRS ↑ 1F','up']],doorsV:[[1030,468,575,true,'TERRACE']]};
// First floor (rotated): kitchen/pass/bar counter strip along the back wall,
// stairs DOWN to GF on the right, kitchen door on the left.
function drawFFExtras(){
  // kitchen blocked out as one zone (left of the divider at x=657)
  ctx.fillStyle='#46464e';ctx.fillRect(165,129,491,550);
  ctx.strokeStyle='#6a6a74';ctx.lineWidth=1;for(let gx=182;gx<657;gx+=22){ctx.beginPath();ctx.moveTo(gx,129);ctx.lineTo(gx,679);ctx.stroke();}
  ctx.strokeStyle='#2a2a30';ctx.lineWidth=2;ctx.strokeRect(165,129,491,550);
  ctx.fillStyle='#d6d9e2';ctx.textAlign='center';ctx.font='bold 18px monospace';ctx.fillText('KITCHEN',410,395);
  ctx.font='bold 10px monospace';ctx.fillStyle='#9aa0ac';ctx.fillText('PASS · HOT PASS · BAR · PREP',410,418);ctx.textAlign='left';
  // stairs down to GF (bottom-centre)
  const sx0=372,sx1=600,sy=626;
  for(let i=0;i<5;i++){ctx.strokeStyle='#6a4626';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(sx0,sy+i*9);ctx.lineTo(sx1,sy+i*9);ctx.stroke();}
  ctx.strokeStyle=P.wallHi;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(sx0,sy);ctx.lineTo(sx0,sy+46);ctx.moveTo(sx1,sy);ctx.lineTo(sx1,sy+46);ctx.stroke();
  const scx=(sx0+sx1)/2;ctx.fillStyle='#e0b060';ctx.beginPath();ctx.moveTo(scx,sy+40);ctx.lineTo(scx-6,sy+28);ctx.lineTo(scx+6,sy+28);ctx.closePath();ctx.fill();
  ctx.fillStyle='#ffd27a';ctx.font='bold 9px monospace';ctx.textAlign='center';ctx.fillText('STAIRS ↓ GF',scx,sy+58);ctx.textAlign='left';
  // entrance from kitchen/stairs into the seating (opening in the divider)
  const dy0=486,dy1=566;ctx.fillStyle=P.fpA;ctx.fillRect(653,dy0,8,dy1-dy0);
  ctx.strokeStyle='#d8b048';ctx.lineWidth=2.5;ctx.beginPath();ctx.moveTo(657,dy1);ctx.lineTo(657+(dy1-dy0),dy1);ctx.stroke();
  ctx.strokeStyle='rgba(216,176,72,.55)';ctx.lineWidth=1.5;ctx.setLineDash([4,3]);ctx.beginPath();ctx.arc(657,dy1,dy1-dy0,-Math.PI/2,0);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle='#ffd27a';ctx.font='bold 9px monospace';ctx.textAlign='center';ctx.fillText('ENTRANCE',700,dy0-3);ctx.textAlign='left';
}
function drawStairs(x0,x1,wy,label,dir){
  ctx.fillStyle=P.fpB;ctx.fillRect(x0,wy-4,x1-x0,8);
  ctx.strokeStyle=P.wallHi;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x0,wy);ctx.lineTo(x0,wy+46);ctx.moveTo(x1,wy);ctx.lineTo(x1,wy+46);ctx.stroke();
  ctx.strokeStyle='#6a4626';ctx.lineWidth=2;for(let i=1;i<=4;i++){const ty=wy+i*9;ctx.beginPath();ctx.moveTo(x0+2,ty);ctx.lineTo(x1-2,ty);ctx.stroke();}
  const cx=(x0+x1)/2;ctx.fillStyle='#e0b060';ctx.beginPath();
  if(dir==='up'){ctx.moveTo(cx,wy+6);ctx.lineTo(cx-6,wy+18);ctx.lineTo(cx+6,wy+18);}else{ctx.moveTo(cx,wy+20);ctx.lineTo(cx-6,wy+8);ctx.lineTo(cx+6,wy+8);}
  ctx.closePath();ctx.fill();
  ctx.fillStyle='#ffd27a';ctx.font='bold 9px monospace';ctx.textAlign='center';ctx.fillText(label,cx,wy+42);ctx.textAlign='left';
}
function drawDoorV(wx,a,b,inward,label){
  const len=b-a;ctx.fillStyle=P.fpB;ctx.fillRect(wx-4,a,8,len);
  ctx.strokeStyle=P.wall;ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(wx,a-4);ctx.lineTo(wx,a);ctx.moveTo(wx,b);ctx.lineTo(wx,b+4);ctx.stroke();
  const dir=inward?-1:1;ctx.strokeStyle='#d8b048';ctx.lineWidth=2.5;ctx.beginPath();ctx.moveTo(wx,a);ctx.lineTo(wx+dir*len,a);ctx.stroke();
  ctx.strokeStyle='rgba(216,176,72,.5)';ctx.lineWidth=1.5;ctx.setLineDash([4,3]);ctx.beginPath();ctx.arc(wx,a,len,inward?Math.PI:0,Math.PI/2,inward);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle='#ffd27a';ctx.font='bold 9px monospace';ctx.textAlign='center';ctx.save();ctx.translate(wx-dir*14,(a+b)/2);ctx.rotate(-Math.PI/2);ctx.fillText(label,0,0);ctx.restore();ctx.textAlign='left';
}
function drawFixtures(){
  if(currentFloor==='ff'){drawFFExtras();return;}
  (GF_FIX.stairs||[]).forEach(s=>drawStairs(s[0],s[1],s[2],s[3],s[4]));
  (GF_FIX.doorsV||[]).forEach(d=>drawDoorV(d[0],d[1],d[2],d[3],d[4]));
}

/* ── Main render ─────────────────────────────────────────────────────────── */
function render(ts){ts=ts||0;requestAnimationFrame(render);
  if(ts-lastRender<80)return;lastRender=ts;animFrame++;
  ctx.clearRect(0,0,CW,CH);ctx.fillStyle='#0a0604';ctx.fillRect(0,0,CW,CH);
  drawFloor();drawBackWall(animFrame);drawWalls();drawFixtures();
  [...curTables()].sort((a,b)=>a.cy-b.cy).forEach(drawTable);
  stepGuests();
  drawWalkingGuests();
  if(editMode)drawEditOverlay();}

/* ── RTDB data ───────────────────────────────────────────────────────────── */
// Suppress only actively-moving walkers (walker draws them); seated walkers are drawn by table
function getGuests(id){
  return Object.entries(floorData.guests||{})
    .filter(([uid,g])=>g.tableId===id && !(guestWalk[uid]&&guestWalk[uid].state!=='seated'))
    .map(([,g])=>g.name||g.guestName||'Guest');
}

function setLive(ok){const el=document.getElementById('live-ind');
  el.textContent=ok?'● LIVE':'✕ ERR';el.style.color=ok?'#40c040':'#c04040';}

/* Poll tables only (changes infrequently) */
async function poll(){try{
    const r=await fetch(RTDB+'/tables.json').then(r=>r.json());
    floorData.tables=r||{};updateSidebar();setLive(true);
  }catch(e){setLive(false);}}

/* Real-time stream for active_guests via Firebase SSE */
let _guestSrc=null;
function startGuestStream(){
  if(_guestSrc){_guestSrc.close();}
  _guestSrc=new EventSource(RTDB+'/active_guests.json?stream=true');
  _guestSrc.addEventListener('put',e=>{
    try{
      const d=JSON.parse(e.data);
      if(d.path==='/'){floorData.guests=d.data||{};}
      else{
        const key=d.path.replace(/^\//,'');
        if(d.data===null){delete floorData.guests[key];}
        else{floorData.guests[key]=d.data;}
      }
      syncGuestWalk(floorData.guests);
      updateSidebar();setLive(true);
    }catch(_){}
  });
  _guestSrc.addEventListener('patch',e=>{
    try{
      const d=JSON.parse(e.data);
      Object.assign(floorData.guests,d.data||{});
      syncGuestWalk(floorData.guests);
      updateSidebar();setLive(true);
    }catch(_){}
  });
  _guestSrc.onerror=()=>{setLive(false);
    // Reconnect after 3 s
    setTimeout(startGuestStream,3000);};
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
function updateSidebar(){const tbl=floorData.tables||{},gs=floorData.guests||{};
  const gNames=Object.values(gs).map(g=>g.name||g.guestName||'Guest');
  const occIds=Object.keys(tbl).filter(k=>tbl[k]&&tbl[k].arrivedAt);
  document.getElementById('s-guests').textContent=gNames.length||'0';
  document.getElementById('s-tables').textContent=occIds.length?occIds.length+' / '+Object.keys(tbl).length:'—';
  const tlist=document.getElementById('tlist');tlist.innerHTML='';
  for(const t of curTables()){const td=tbl[t.id]||{};const occ=!!td.arrivedAt;const g=getGuests(t.id);
    const div=document.createElement('div');div.className='ti'+(occ?' occ':'');
    const since=td.arrivedAt?'Since '+new Date(td.arrivedAt).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}):'';
    div.innerHTML='<div class="ti-name"><span class="dot '+(occ?'on':'off')+'"></span>'+t.name+'</div>'+
      (occ?'<div class="ti-guest">'+(g.join(', ')||'Occupied')+'</div><div class="ti-since">'+since+'</div>':'<div style="color:#3a2a1a;font-size:8px">empty</div>');
    tlist.appendChild(div);}
  const lastG=Object.values(gs).sort((a,b)=>(b.arrivedAt||0)-(a.arrivedAt||0))[0];
  if(lastG)document.getElementById('lasttap').innerHTML='<b style="color:#f0c060">'+(lastG.name||'Guest')+'</b><br>Table '+(lastG.tableId||'?')+'<br>'+(lastG.arrivedAt?new Date(lastG.arrivedAt).toLocaleTimeString('en-GB'):'');}

/* ── Clock ───────────────────────────────────────────────────────────────── */
function tick(){const n=new Date();document.getElementById('clock').textContent=String(n.getHours()).padStart(2,'0')+':'+String(n.getMinutes()).padStart(2,'0');
  document.getElementById('dateline').textContent=n.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'}).toUpperCase();}

/* ── Floor switch ────────────────────────────────────────────────────────── */
function setFloor(f){currentFloor=f;PXMM=(f==='gf')?PXMM_GF:PXMM_FF;selectedId=null;hoverId=null;drag=null;
  document.querySelectorAll('#floor-btns button').forEach((b,i)=>b.classList.toggle('active',i===(f==='gf'?0:1)));updateSidebar();}

/* ── Edit mode + add/remove ──────────────────────────────────────────────── */
const LS_KEY='tavern_layout_v3';
let editMode=false,selectedId=null,hoverId=null,drag=null;
function toggleEdit(){editMode=!editMode;selectedId=null;hoverId=null;drag=null;
  document.getElementById('edit-btn').classList.toggle('active',editMode);
  document.getElementById('save-btn').style.display=editMode?'':'none';
  document.getElementById('reset-btn').style.display=editMode?'':'none';
  document.getElementById('add-tools').style.display=editMode?'flex':'none';
  canvas.style.cursor=editMode?'default':'crosshair';document.getElementById('tooltip').style.display='none';}
const TYPE_LABEL={'2top':'2-Top','4top':'4-Top','communal':'Communal','banquet':'Banquet','wall2':'Nook'};
function addTable(type){
  if(!editMode)toggleEdit();
  const id=(currentFloor==='gf'?'G':'F')+'N'+(idSeq++);
  const rot=(type==='banquet'||type==='wall2')?90:0;
  const t={id:id,name:(TYPE_LABEL[type]||'Table')+' '+idSeq,type:type,cx:CW/2,cy:Math.round((WALL_H+CH)/2),rot:rot};
  curTables().push(t);selectedId=id;updateSidebar();}
function deleteSelected(){if(!selectedId)return;setCurTables(curTables().filter(t=>t.id!==selectedId));selectedId=null;hoverId=null;drag=null;updateSidebar();}
function snapshot(){const pick=a=>a.map(t=>({id:t.id,name:t.name,type:t.type,cx:Math.round(t.cx),cy:Math.round(t.cy),rot:t.rot}));return{gf:pick(GF_TABLES),ff:pick(FF_TABLES),seq:idSeq};}
/* ── Rename + RTDB cloud sync ─────────────────────────────────────────────── */
const LAYOUT_PATH=RTDB+'/tavern_layout';
function renameTable(id){const t=tableById(id);if(!t)return;const v=prompt('Table name or number:',t.name);if(v!==null){const nv=String(v).trim();if(nv){t.name=nv;updateSidebar();}}}
function tableConfig(t){return{name:t.name,type:t.type,cx:Math.round(t.cx),cy:Math.round(t.cy),rot:t.rot,floor:currentFloor};}
async function cloudSave(){
  const floor=currentFloor,data={};
  for(const t of curTables())data[t.id]=tableConfig(t);
  const reqs=[fetch(LAYOUT_PATH+'/'+floor+'.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})];
  // mirror the display name onto each /tables/{id} record (PATCH keeps occupancy)
  for(const t of curTables())reqs.push(fetch(RTDB+'/tables/'+t.id+'.json',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:t.name})}));
  const res=await Promise.all(reqs);
  if(res.some(r=>!r.ok))throw new Error('HTTP '+(res.find(r=>!r.ok)||{}).status);
}
async function cloudLoad(){
  let any=false;
  for(const f of ['gf','ff']){
    try{const d=await fetch(LAYOUT_PATH+'/'+f+'.json').then(r=>r.json());
      if(d&&typeof d==='object'){
        const arr=Object.keys(d).map(id=>({id:id,name:d[id].name||id,type:d[id].type||'2top',cx:+d[id].cx||CW/2,cy:+d[id].cy||CH/2,rot:+d[id].rot||0}));
        if(arr.length){if(f==='gf')GF_TABLES=arr;else FF_TABLES=arr;any=true;}
      }
    }catch(e){/* offline / not yet saved → keep local */}
  }
  if(any)updateSidebar();
}
async function saveLayout(){
  const b=document.getElementById('save-btn');
  try{localStorage.setItem(LS_KEY,JSON.stringify(snapshot()));}catch(e){}
  b.textContent='☁ Saving…';
  try{await cloudSave();b.textContent='✓ Synced';}catch(e){console.warn('cloud save failed',e);b.textContent='✕ Cloud err';}
  setTimeout(()=>{b.textContent='💾 Save';},1600);
}
function loadLayout(){try{const r=localStorage.getItem(LS_KEY);if(!r)return;const s=JSON.parse(r);
  if(s.gf)GF_TABLES=s.gf;if(s.ff)FF_TABLES=s.ff;if(s.seq)idSeq=s.seq;}catch(e){}}
function resetLayout(){GF_TABLES=JSON.parse(JSON.stringify(GF_DEFAULT));FF_TABLES=JSON.parse(JSON.stringify(FF_DEFAULT));
  try{localStorage.removeItem(LS_KEY);}catch(e){}selectedId=null;updateSidebar();}

/* ── Edit overlay (ring, rotate + delete handles) ────────────────────────── */
const ROT_R=11,DEL_R=10;
function rotHandle(t){const b=tbbox(t);return{x:(b.x0+b.x1)/2,y:b.y0-16};}
function delHandle(t){const b=tbbox(t);return{x:b.x1+12,y:b.y0-2};}
function drawEditOverlay(){
  if(hoverId&&hoverId!==selectedId){const t=tableById(hoverId);if(t){const b=tbbox(t);ctx.save();ctx.strokeStyle='rgba(255,215,0,.4)';ctx.lineWidth=1.5;ctx.setLineDash([4,3]);ctx.strokeRect(b.x0+.5,b.y0+.5,b.x1-b.x0,b.y1-b.y0);ctx.restore();}}
  const t=selectedId&&tableById(selectedId);if(!t)return;const b=tbbox(t);
  ctx.save();ctx.strokeStyle='#ffd700';ctx.lineWidth=2;ctx.setLineDash([6,4]);ctx.strokeRect(b.x0+.5,b.y0+.5,b.x1-b.x0,b.y1-b.y0);ctx.setLineDash([]);
  const h=rotHandle(t);ctx.strokeStyle='#ffd700';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo((b.x0+b.x1)/2,b.y0);ctx.lineTo(h.x,h.y+ROT_R);ctx.stroke();
  ctx.fillStyle='#1a0f07';ctx.beginPath();ctx.arc(h.x,h.y,ROT_R,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.fillStyle='#ffd700';ctx.font='bold 12px monospace';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('↻',h.x,h.y+1);
  const dh=delHandle(t);ctx.fillStyle='#1a0f07';ctx.strokeStyle='#e04828';ctx.lineWidth=2;ctx.beginPath();ctx.arc(dh.x,dh.y,DEL_R,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.fillStyle='#e87058';ctx.fillText('✕',dh.x,dh.y+1);ctx.textBaseline='alphabetic';ctx.textAlign='left';ctx.restore();}

/* ── Tooltip + pointer ───────────────────────────────────────────────────── */
const tooltip=document.getElementById('tooltip');
function cpos(e){const r=canvas.getBoundingClientRect();return{mx:(e.clientX-r.left)*(CW/r.width),my:(e.clientY-r.top)*(CH/r.height)};}
function tableHit(mx,my){const ts=[...curTables()].sort((a,b)=>b.cy-a.cy);for(const t of ts){const b=tbbox(t);if(mx>=b.x0&&mx<=b.x1&&my>=b.y0&&my<=b.y1)return t;}return null;}
canvas.addEventListener('mousedown',e=>{if(!editMode)return;const p=cpos(e);const mx=p.mx,my=p.my;const sel=selectedId&&tableById(selectedId);
  if(sel){const h=rotHandle(sel);if(Math.hypot(mx-h.x,my-h.y)<=ROT_R+3){sel.rot=(sel.rot+90)%360;drag=null;return;}
    const dh=delHandle(sel);if(Math.hypot(mx-dh.x,my-dh.y)<=DEL_R+3){deleteSelected();return;}}
  const t=tableHit(mx,my);if(t){selectedId=t.id;drag={id:t.id,dx:mx-t.cx,dy:my-t.cy};}else selectedId=null;});
canvas.addEventListener('mousemove',e=>{const p=cpos(e);const mx=p.mx,my=p.my;
  if(editMode){tooltip.style.display='none';
    if(drag){const t=tableById(drag.id);if(t){t.cx=Math.max(40,Math.min(CW-40,Math.round(mx-drag.dx)));t.cy=Math.max(WALL_H,Math.min(CH-20,Math.round(my-drag.dy)));}return;}
    const t=tableHit(mx,my);hoverId=t?t.id:null;
    const sel=selectedId&&tableById(selectedId);
    let cur='default';if(sel){const h=rotHandle(sel),dh=delHandle(sel);if(Math.hypot(mx-h.x,my-h.y)<=ROT_R+3)cur='grab';else if(Math.hypot(mx-dh.x,my-dh.y)<=DEL_R+3)cur='pointer';else if(t)cur='move';}else if(t)cur='move';
    canvas.style.cursor=cur;return;}
  const t=tableHit(mx,my);
  if(t){const td=floorData.tables[t.id]||{};const g=getGuests(t.id);const occ=!!td.arrivedAt;
    const since=td.arrivedAt?'Since '+new Date(td.arrivedAt).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}):' ';
    tooltip.innerHTML='<b style="color:#ffd700">'+t.name+'</b><br>'+(occ?'Guests: '+(g.join(', ')||'Occupied')+'<br>'+since:'Available');
    tooltip.style.display='block';tooltip.style.left=(e.clientX+14)+'px';tooltip.style.top=(e.clientY-8)+'px';
  }else tooltip.style.display='none';});
canvas.addEventListener('dblclick',e=>{if(!editMode)return;const p=cpos(e);const t=tableHit(p.mx,p.my);if(t){selectedId=t.id;renameTable(t.id);}});
window.addEventListener('mouseup',()=>{drag=null;});
canvas.addEventListener('mouseleave',()=>{tooltip.style.display='none';if(!drag)hoverId=null;});
window.addEventListener('keydown',e=>{if(e.key==='Escape'){selectedId=null;drag=null;}
  else if((e.key==='Delete'||e.key==='Backspace')&&editMode&&selectedId){e.preventDefault();deleteSelected();}});

/* ── Boot ────────────────────────────────────────────────────────────────── */
loadLayout();cloudLoad();tick();setInterval(tick,1000);
poll();setInterval(poll,30000);   // tables rarely change
startGuestStream();               // active_guests — real-time SSE
requestAnimationFrame(render);
</script>
</body>
</html>
