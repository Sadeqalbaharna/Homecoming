[Unit]
Description=Kai Tavern NFC Station
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kai
WorkingDirectory=/home/kai/tavern_station
ExecStart=/usr/bin/python3 -u /home/kai/tavern_station/nfc_listener.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=TABLE_ID=T01
Environment=TABLE_NAME=Table 1
Environment=ELEVENLABS_KEY=your_key_here
Environment=KAI_VOICE_ID=your_voice_id_here
Environment=OPENAI_KEY=your_openai_key_here
StandardOutput=append:/home/kai/tavern_station/tavern.log
StandardError=append:/home/kai/tavern_station/tavern.log

[Install]
WantedBy=multi-user.target
