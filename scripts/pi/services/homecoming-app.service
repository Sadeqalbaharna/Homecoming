[Unit]
Description=Homecoming D&D Ambiance App
After=network.target bluetooth.service pulseaudio.service
Wants=bluetooth.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 /home/pi/bluetooth_startup_check.py
ExecStartPost=/bin/bash -c 'echo "Bluetooth check complete"'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
